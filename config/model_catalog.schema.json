{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rxycode.dev/schemas/model_catalog.json",
  "title": "RxyCode model catalog",
  "description": "Versioned model capability catalog consumed by OutputLimitResolver (Phase 3). Keys are provider_id + model_id (casefold+strip). Records require a verifiable source.",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "note": { "type": "string" },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "model_id", "source"],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "model_id": { "type": "string", "minLength": 1 },
          "model_context_window": {
            "type": ["integer", "null"],
            "exclusiveMinimum": 0
          },
          "model_max_output_tokens": {
            "type": ["integer", "null"],
            "exclusiveMinimum": 0
          },
          "source": { "type": "string", "minLength": 1 },
          "source_url": { "type": ["string", "null"] },
          "as_of": { "type": ["string", "null"] },
          "cache_contract": {
            "type": "object",
            "required": [
              "cache_mode",
              "cache_hit_discount",
              "usage_fields",
              "reasoning_contract",
              "breakpoints_max",
              "prompt_cache_key_required"
            ],
            "properties": {
              "cache_mode": {
                "type": "string",
                "enum": ["auto", "explicit_breakpoints", "cache_key", "auto_and_key"]
              },
              "cache_hit_discount": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "cache_ttl_hours": { "type": ["number", "null"], "exclusiveMinimum": 0 },
              "min_cache_tokens": { "type": ["integer", "null"], "exclusiveMinimum": 0 },
              "breakpoints_max": { "type": ["integer", "null"], "minimum": 0 },
              "breakpoint_lookback": { "type": ["integer", "null"], "minimum": 0 },
              "usage_fields": {
                "type": "object",
                "required": ["cached"],
                "properties": {
                  "cached": { "type": ["string", "null"] },
                  "cached_alt": { "type": ["string", "null"] },
                  "cache_read": { "type": ["string", "null"] },
                  "cache_creation": { "type": ["string", "null"] },
                  "cost_ticks": { "type": ["string", "null"] },
                  "reasoning": { "type": ["string", "null"] }
                }
              },
              "reasoning_contract": {
                "type": "string",
                "enum": ["mandatory_echo", "thinking_blocks_echo", "none", "no_thinking"]
              },
              "thinking_param": { "type": ["object", "null"] },
              "temperature_override": { "type": ["object", "null"] },
              "prompt_cache_key_required": { "type": "boolean" }
            }
          }
        }
      }
    },
    "families": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["provider_id", "pattern", "source"],
        "properties": {
          "provider_id": { "type": "string", "minLength": 1 },
          "pattern": { "type": "string", "minLength": 1 },
          "model_context_window": {
            "type": ["integer", "null"],
            "exclusiveMinimum": 0
          },
          "model_max_output_tokens": {
            "type": ["integer", "null"],
            "exclusiveMinimum": 0
          },
          "source": { "type": "string", "minLength": 1 },
          "source_url": { "type": ["string", "null"] },
          "as_of": { "type": ["string", "null"] }
        }
      }
    }
  }
}
