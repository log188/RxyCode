{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rxycode.dev/protocol/schema.json",
  "title": "RxyCode Protocol",
  "protocol_version": "1.0.0",
  "$defs": {
    "InitializeRequest": {
      "description": "JSON-RPC handshake on connect (future ``python -m appserver``).\n\n``client_name`` / ``client_version`` identify the OpenTUI or Desktop client;\n``protocol_version`` must equal ``protocol.version.PROTOCOL_VERSION``;\n``capabilities`` is an optional client feature manifest (unused in HTTP mode).",
      "properties": {
        "method": {
          "const": "initialize",
          "default": "initialize",
          "title": "Method",
          "type": "string"
        },
        "client_name": {
          "title": "Client Name",
          "type": "string"
        },
        "client_version": {
          "title": "Client Version",
          "type": "string"
        },
        "protocol_version": {
          "title": "Protocol Version",
          "type": "string"
        },
        "capabilities": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Capabilities"
        }
      },
      "required": [
        "client_name",
        "client_version",
        "protocol_version"
      ],
      "title": "InitializeRequest",
      "type": "object"
    },
    "NewSessionRequest": {
      "description": "Bind a workspace and chat namespace (maps ``_activate_session`` in api_server.py).\n\n``workspace_root`` is the repo root passed to AgentV2 tools (today ``Path.cwd()``);\n``model`` optionally overrides the default from ``config/settings.py``.",
      "properties": {
        "method": {
          "const": "session/new",
          "default": "session/new",
          "title": "Method",
          "type": "string"
        },
        "workspace_root": {
          "title": "Workspace Root",
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model"
        }
      },
      "required": [
        "workspace_root"
      ],
      "title": "NewSessionRequest",
      "type": "object"
    },
    "PromptRequest": {
      "description": "One user turn (maps ``POST /chat`` ``ChatRequest`` in api_server.py).\n\n``session_id`` uses ``memory.long_term.validate_session_id``; ``text`` is\n``ChatRequest.message``; ``timeout_seconds`` mirrors execution tool timeout\nsemantics when appserver enforces wall-clock limits.\n``mode`` selects AgentV2 run mode; ``thinking_expanded`` gates reasoning\nstream emission on ``ProtocolTui``.",
      "properties": {
        "method": {
          "const": "session/prompt",
          "default": "session/prompt",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional wall-clock limit for this prompt (maps execution.tool_timeout_seconds semantics).",
          "title": "Timeout Seconds"
        },
        "mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent run mode (build/plan/compose); defaults to build.",
          "title": "Mode"
        },
        "thinking_expanded": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When true, ProtocolTui emits event/reasoning_snapshot chunks.",
          "title": "Thinking Expanded"
        }
      },
      "required": [
        "session_id",
        "text"
      ],
      "title": "PromptRequest",
      "type": "object"
    },
    "InterruptRequest": {
      "description": "Cancel the in-flight run (maps ``POST /cancel`` + ``Session.interrupt`` in api_server.py).\n\n``session_id`` matches the active ``ChatRequest.session_id`` namespace.",
      "properties": {
        "method": {
          "const": "session/interrupt",
          "default": "session/interrupt",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "InterruptRequest",
      "type": "object"
    },
    "SetThinkingExpandedRequest": {
      "description": "Sync OpenTUI /thinking expand state into appserver ProtocolTui.\n\n``expanded`` mirrors the client Thought panel; when a prompt is in flight the\nbound worker TUI is updated so mid-run expand can push an accumulated snapshot.",
      "properties": {
        "method": {
          "const": "session/set_thinking_expanded",
          "default": "session/set_thinking_expanded",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "expanded": {
          "title": "Expanded",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "expanded"
      ],
      "title": "SetThinkingExpandedRequest",
      "type": "object"
    },
    "WarmSessionRequest": {
      "description": "Pre-bootstrap AgentV2 for a session so the first prompt is not cold-start.\n\nMaps appserver ``AgentHost.ensure_bootstrapped`` without running a user turn.",
      "properties": {
        "method": {
          "const": "session/warm",
          "default": "session/warm",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "timeout_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional wall-clock limit for bootstrap (defaults to appserver warm timeout).",
          "title": "Timeout Seconds"
        }
      },
      "required": [
        "session_id"
      ],
      "title": "WarmSessionRequest",
      "type": "object"
    },
    "ShutdownRequest": {
      "description": "Graceful appserver shutdown (future ``appserver`` lifespan teardown).\n\n``reason`` is logged on stderr only; HTTP ``api_server`` mode ignores this today.",
      "properties": {
        "method": {
          "const": "shutdown",
          "default": "shutdown",
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "title": "ShutdownRequest",
      "type": "object"
    },
    "ModelsListRequest": {
      "description": "List configured models with provider grouping and Phase 3 limit summary.\n\nMaps ``models/list``. Response carries ``models``, ``active``, ``recent``.",
      "properties": {
        "method": {
          "const": "models/list",
          "default": "models/list",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ModelsListRequest",
      "type": "object"
    },
    "ModelsPresetsRequest": {
      "description": "List provider connection presets (base URL only, no model ids).\n\nMaps ``models/presets``; the client discovers ids via ``models/discover``.",
      "properties": {
        "method": {
          "const": "models/presets",
          "default": "models/presets",
          "title": "Method",
          "type": "string"
        }
      },
      "title": "ModelsPresetsRequest",
      "type": "object"
    },
    "ModelsDiscoverRequest": {
      "description": "Probe a provider catalogue with a credential; never persists.\n\nMaps ``models/discover``. ``api_key`` is never stored or echoed.",
      "properties": {
        "method": {
          "const": "models/discover",
          "default": "models/discover",
          "title": "Method",
          "type": "string"
        },
        "api_key": {
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        }
      },
      "required": [
        "api_key",
        "base_url"
      ],
      "title": "ModelsDiscoverRequest",
      "type": "object"
    },
    "ModelsOnboardRequest": {
      "description": "Probe credentials in memory and persist a working model mapping.\n\nMaps ``models/onboard``. ``api_key`` is stored by the backend\ncredential_store (Windows DPAPI) and never returned.",
      "properties": {
        "method": {
          "const": "models/onboard",
          "default": "models/onboard",
          "title": "Method",
          "type": "string"
        },
        "provider_model_id": {
          "title": "Provider Model Id",
          "type": "string"
        },
        "api_key": {
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "nickname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nickname"
        }
      },
      "required": [
        "provider_model_id",
        "api_key",
        "base_url"
      ],
      "title": "ModelsOnboardRequest",
      "type": "object"
    },
    "ModelsOnboardBatchRequest": {
      "description": "Probe + persist multiple models with one credential.\n\nMaps ``models/onboard_batch``.",
      "properties": {
        "method": {
          "const": "models/onboard_batch",
          "default": "models/onboard_batch",
          "title": "Method",
          "type": "string"
        },
        "api_key": {
          "title": "Api Key",
          "type": "string"
        },
        "base_url": {
          "title": "Base Url",
          "type": "string"
        },
        "model_ids": {
          "items": {
            "type": "string"
          },
          "title": "Model Ids",
          "type": "array"
        },
        "provider_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Id"
        },
        "provider_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Name"
        },
        "active_model_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Active Model Id"
        },
        "skip_probe": {
          "default": true,
          "title": "Skip Probe",
          "type": "boolean"
        }
      },
      "required": [
        "api_key",
        "base_url",
        "model_ids"
      ],
      "title": "ModelsOnboardBatchRequest",
      "type": "object"
    },
    "ModelsRemoveRequest": {
      "description": "Remove a model by config key.\n\nMaps ``models/remove``.",
      "properties": {
        "method": {
          "const": "models/remove",
          "default": "models/remove",
          "title": "Method",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModelsRemoveRequest",
      "type": "object"
    },
    "ModelsSetActiveRequest": {
      "description": "Switch the active model.\n\nMaps ``models/set_active``.",
      "properties": {
        "method": {
          "const": "models/set_active",
          "default": "models/set_active",
          "title": "Method",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModelsSetActiveRequest",
      "type": "object"
    },
    "ModelsTestConnectionRequest": {
      "description": "Live credential test for an existing model.\n\nMaps ``models/test_connection``.",
      "properties": {
        "method": {
          "const": "models/test_connection",
          "default": "models/test_connection",
          "title": "Method",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "ModelsTestConnectionRequest",
      "type": "object"
    },
    "CredentialsUpsertRequest": {
      "description": "Store/refresh a model API key (backend DPAPI, never echoed).\n\nMaps ``credentials/upsert``.",
      "properties": {
        "method": {
          "const": "credentials/upsert",
          "default": "credentials/upsert",
          "title": "Method",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "api_key": {
          "title": "Api Key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "api_key"
      ],
      "title": "CredentialsUpsertRequest",
      "type": "object"
    },
    "CredentialsDeleteRequest": {
      "description": "Clear a model's stored API key reference.\n\nMaps ``credentials/delete``.",
      "properties": {
        "method": {
          "const": "credentials/delete",
          "default": "credentials/delete",
          "title": "Method",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "CredentialsDeleteRequest",
      "type": "object"
    },
    "AgentEvent": {
      "description": "Runtime agent event (Phase E4; E-layer bus carries these).\n\nField matrix (PHASE-E §4.1, authoritative):\n  method                | experiment_tag | cache_miss | tokens | budget | source | routing_reason\n  ----------------------|--------------- |------------|--------|--------|--------|---------------\n  agent_started         | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_tool            | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_progress        | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_done            | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_paused          | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_cancelled       | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_budget_exceeded | opt            | opt        | **req  | **req  | opt    | forbid\n  agent_denied          | opt            | opt        | req*   | req*   | opt    | forbid\n  agent_routed          | **req          | opt        | req*   | req*   | opt    | **req\n  agent_team_created    | forbid         | opt        | req*   | req*   | opt    | forbid\n\n``req*`` = the E3 runtime always writes these (0 at spawn, monotonic);\nthe schema compatibility layer allows them to be absent (historical\nevents).  ``**req`` = hard requirement at this layer; ``forbid`` =\ncarrying the field is rejected.  ``tokens_used``/``budget_used`` are\nstrict ints (bool/str/float rejected) and non-negative cumulative\nsnapshots.  ``source`` distinguishes bridge-replayed events; unknown\nvalues are rejected on construction and deserialization.",
      "properties": {
        "method": {
          "enum": [
            "event/agent_started",
            "event/agent_tool",
            "event/agent_progress",
            "event/agent_done",
            "event/agent_paused",
            "event/agent_cancelled",
            "event/agent_budget_exceeded",
            "event/agent_denied",
            "event/agent_routed",
            "event/agent_team_created"
          ],
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "agent_id": {
          "title": "Agent Id",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        },
        "seq": {
          "title": "Seq",
          "type": "integer"
        },
        "experiment_tag": {
          "anyOf": [
            {
              "enum": [
                "E0",
                "E1",
                "E2"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Experiment Tag"
        },
        "cache_miss_warning": {
          "default": false,
          "title": "Cache Miss Warning",
          "type": "boolean"
        },
        "tokens_used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Used"
        },
        "budget_used": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Budget Used"
        },
        "source": {
          "anyOf": [
            {
              "enum": [
                "internal",
                "bridge"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "routing_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Routing Reason"
        }
      },
      "required": [
        "method",
        "session_id",
        "agent_id",
        "seq"
      ],
      "title": "AgentEvent",
      "type": "object"
    },
    "MessageDelta": {
      "description": "SSE ``type: token`` via ``StreamTUI._buffer(\"token\")`` / flush (api_server.py).",
      "properties": {
        "method": {
          "const": "event/message_delta",
          "default": "event/message_delta",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "text"
      ],
      "title": "MessageDelta",
      "type": "object"
    },
    "ProgressUpdate": {
      "description": "SSE ``type: progress`` from ``StreamTUI.write_progress`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/progress",
          "default": "event/progress",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "text"
      ],
      "title": "ProgressUpdate",
      "type": "object"
    },
    "ReasoningSnapshot": {
      "description": "SSE ``type: reasoning`` with ``snapshot: true`` from ``StreamTUI._emit_thinking_snapshot`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/reasoning_snapshot",
          "default": "event/reasoning_snapshot",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "text": {
          "title": "Text",
          "type": "string"
        },
        "snapshot": {
          "default": true,
          "title": "Snapshot",
          "type": "boolean"
        }
      },
      "required": [
        "session_id",
        "text"
      ],
      "title": "ReasoningSnapshot",
      "type": "object"
    },
    "PlanUpdate": {
      "description": "SSE ``type: plan`` from ``StreamTUI.write_plan`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/plan",
          "default": "event/plan",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "steps": {
          "items": {
            "type": "string"
          },
          "title": "Steps",
          "type": "array"
        }
      },
      "required": [
        "session_id",
        "steps"
      ],
      "title": "PlanUpdate",
      "type": "object"
    },
    "StepProgress": {
      "description": "SSE ``type: step`` from ``StreamTUI.write_step`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/step",
          "default": "event/step",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "index": {
          "title": "Index",
          "type": "integer"
        },
        "total": {
          "title": "Total",
          "type": "integer"
        },
        "text": {
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "index",
        "total",
        "text"
      ],
      "title": "StepProgress",
      "type": "object"
    },
    "TaskStarted": {
      "description": "Structured task boundary for LangGraph runs (future emit from chat worker).",
      "properties": {
        "method": {
          "const": "event/task_started",
          "default": "event/task_started",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "task_id": {
          "title": "Task Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "session_id",
        "task_id",
        "title"
      ],
      "title": "TaskStarted",
      "type": "object"
    },
    "ToolBegin": {
      "description": "SSE ``type: tool_call`` from ``StreamTUI.write_tool_call`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/tool_begin",
          "default": "event/tool_begin",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "tool_name": {
          "title": "Tool Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "session_id",
        "call_id",
        "tool_name"
      ],
      "title": "ToolBegin",
      "type": "object"
    },
    "ToolEnd": {
      "description": "SSE ``type: tool_result`` from ``StreamTUI.write_tool_result`` (api_server.py).",
      "properties": {
        "method": {
          "const": "event/tool_end",
          "default": "event/tool_end",
          "title": "Method",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "ok": {
          "title": "Ok",
          "type": "boolean"
        },
        "summary": {
          "title": "Summary",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        }
